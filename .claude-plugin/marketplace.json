{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "vizzletf-skills",
  "description": "Claude Code skills by VizzleTF",
  "owner": {
    "name": "VizzleTF",
    "url": "https://github.com/VizzleTF"
  },
  "renames": {
    "technical-writing-ru": "technical-writing"
  },
  "plugins": [
    {
      "name": "technical-writing",
      "source": "./plugins/technical-writing",
      "description": "Writes and reviews documentation by document type: tutorial, how-to, runbook, reference, ADR, changelog and more. English and Russian style rules, chosen by the language of the document.",
      "author": {
        "name": "VizzleTF",
        "url": "https://github.com/VizzleTF"
      },
      "homepage": "https://github.com/VizzleTF/claude-skills/tree/main/plugins/technical-writing",
      "repository": "https://github.com/VizzleTF/claude-skills",
      "license": "MIT",
      "category": "documentation",
      "tags": [
        "docs",
        "writing",
        "review",
        "russian"
      ]
    },
    {
      "name": "tidemark",
      "source": "./plugins/tidemark",
      "description": "Configurable band above the Claude Code prompt: context, cache, quota, model, git and more, with a details pane and a config editor.",
      "author": {
        "name": "VizzleTF",
        "url": "https://github.com/VizzleTF"
      },
      "homepage": "https://github.com/VizzleTF/claude-skills/tree/main/plugins/tidemark",
      "repository": "https://github.com/VizzleTF/claude-skills",
      "license": "MIT",
      "category": "productivity",
      "tags": [
        "mod",
        "status",
        "context",
        "quota"
      ]
    },
    {
      "name": "vi-voice",
      "source": "./plugins/vi-voice",
      "description": "Short chat replies: answer first, a five-line body, no ceremony, facts verbatim. The reply language comes from the language setting. About 570 tokens per session.",
      "author": {
        "name": "VizzleTF",
        "url": "https://github.com/VizzleTF"
      },
      "homepage": "https://github.com/VizzleTF/claude-skills/tree/main/plugins/vi-voice",
      "repository": "https://github.com/VizzleTF/claude-skills",
      "license": "MIT",
      "category": "productivity",
      "tags": [
        "style",
        "russian",
        "tokens"
      ]
    },
    {
      "name": "vi-code",
      "source": "./plugins/vi-code",
      "description": "Coding rules at session start: reuse first, validate at trust boundaries, fix every caller, test new logic, find the cause before the fix.",
      "author": {
        "name": "VizzleTF",
        "url": "https://github.com/VizzleTF"
      },
      "homepage": "https://github.com/VizzleTF/claude-skills/tree/main/plugins/vi-code",
      "repository": "https://github.com/VizzleTF/claude-skills",
      "license": "MIT",
      "category": "productivity",
      "tags": [
        "coding",
        "rules",
        "debugging"
      ]
    },
    {
      "name": "vi-work",
      "source": "./plugins/vi-work",
      "description": "Work rules at session start: finish owed work before ending a turn, ask only what blocks, never retry a denied step in another form, check subagent absence claims, keep decisions through compaction.",
      "author": {
        "name": "VizzleTF",
        "url": "https://github.com/VizzleTF"
      },
      "homepage": "https://github.com/VizzleTF/claude-skills/tree/main/plugins/vi-work",
      "repository": "https://github.com/VizzleTF/claude-skills",
      "license": "MIT",
      "category": "productivity",
      "tags": [
        "workflow",
        "rules",
        "subagents"
      ]
    },
    {
      "name": "critique",
      "source": "./plugins/critique",
      "description": "Parallel read-only critics and a cold reader review your work; Claude checks each finding, fixes what holds up inside the zone you own, and repeats until nothing critical is left.",
      "author": {
        "name": "VizzleTF",
        "url": "https://github.com/VizzleTF"
      },
      "homepage": "https://github.com/VizzleTF/claude-skills/tree/main/plugins/critique",
